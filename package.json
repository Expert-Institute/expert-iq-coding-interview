{
    "name": "expert-review-challenge",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace @challenge/api\" \"npm run dev --workspace @challenge/web\"",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.9",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "concurrently": "10.0.7",
        "eslint": "10.14.0",
        "globals": "17.14.0",
        "jsdom": "31.0.0",
        "supertest": "7.3.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vite": "8.3.7",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=26"
    }
}
