{
    "name": "expert-review-challenge",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace @challenge/api\" \"npm run dev --workspace @challenge/web\"",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "package:candidate": "node interviewer-kit/scripts/package-candidate.mjs",
        "test:author": "vitest run --config interviewer-kit/hidden-tests/vitest.config.ts"
    },
    "devDependencies": {
        "@eslint/js": "9.39.1",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/express": "5.0.3",
        "@types/node": "24.10.1",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@vitejs/plugin-react": "5.1.0",
        "concurrently": "9.2.4",
        "eslint": "9.39.1",
        "globals": "16.4.0",
        "jsdom": "27.1.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "rimraf": "6.1.0",
        "supertest": "7.1.4",
        "typescript": "5.8.3",
        "typescript-eslint": "8.46.2",
        "vite": "7.1.11",
        "vitest": "4.0.7"
    },
    "overrides": {
        "react": "19.2.0",
        "react-dom": "19.2.0"
    }
}
